# Production Caddyfile: /api/* goes to Symfony, everything else is the React SPA.
{
	skip_install_trust
	admin off
	frankenphp
}

# Plain HTTP: Render terminates TLS in front of the container.
:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	@api path /api /api/*
	handle @api {
		# Keeps the original REQUEST_URI and query string for Symfony routing.
		rewrite * /index.php
		php
	}

	# Vite emits content-hashed file names, so they can be cached forever.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Client-side routes (/store, /product/x, ...) fall back to the SPA shell.
	handle {
		@phpFile path *.php
		respond @phpFile 404
		try_files {path} /index.html
		header /index.html Cache-Control "no-cache"
		file_server
	}
}
